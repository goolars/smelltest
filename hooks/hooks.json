{
  "//": "smelltest hooks. Stop/SubagentStop run the structural gate (inert unless armed). PostToolUse notes blind edits. The destructive-command guard was spun out (orthogonal security niche). Requires Node >=22.6 to run .ts directly, or `npm run build` for a Node-18 dist (see README).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/note-blind-edit.ts\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.ts\"", "timeout": 15 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/stop-gate.ts\"", "timeout": 15 }
        ]
      }
    ]
  }
}

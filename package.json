{
  "name": "smelltest",
  "version": "0.3.0",
  "description": "A Claude Code hook that catches your agent's fake \"done\" against the git diff — and can't loop or burn your tokens.",
  "type": "module",
  "bin": {
    "smelltest": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "hooks",
    "commands",
    "agents",
    "skills",
    ".claude-plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "eval": "node eval/run.ts",
    "demo": "node eval/demo.mjs",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "smelltest": "node src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "claude-code",
    "hooks",
    "agents",
    "verification",
    "guardrails",
    "completion-check",
    "loop-safety",
    "self-critique"
  ],
  "license": "MIT",
  "author": "goolars"
}
